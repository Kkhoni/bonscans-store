# ---------------------------------------------------------------------------
# Luminae Press storefront — copy to `.env` and fill in your own values.
# `.env` is git-ignored. Never commit real keys.
# ---------------------------------------------------------------------------

# Server (most hosts set PORT for you; bind HOST=0.0.0.0 when hosting)
PORT=4173
HOST=127.0.0.1

# Store the catalogue, orders and PDFs somewhere that survives redeploys.
# Leave empty to use ./data. On a PaaS set it to the mounted disk, e.g. /var/data
DATA_DIR=

# Administrator dashboard (http://localhost:4173/admin.html)
# If left empty, a random password is generated on first start and printed
# in the terminal + saved to data/.admin-password
ADMIN_PASSWORD=change-this-to-a-long-password

# Razorpay — https://dashboard.razorpay.com/app/keys
# Without these, automatic payment verification is OFF (manual UPI only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay webhook — Dashboard → Account & Settings → Webhooks
# URL: https://YOUR-DOMAIN/api/webhooks/razorpay
# Events: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=

# Optional: stable cookie-signing secret. Auto-generated if empty.
SESSION_SECRET=

# How long signed PDF download links stay valid (seconds)
DOWNLOAD_LINK_TTL_SECONDS=3600
